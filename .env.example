# Site URL (Paddle checkout return + sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL — free tier at https://neon.tech
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Admin dashboard password — /admin/login
ADMIN_PASSWORD=change-me-to-a-strong-password

# Reader access token signing (change in production)
ACCESS_TOKEN_SECRET=change-me-in-production

# Paddle Billing (Live) — https://vendors.paddle.com
# Developer tools → Authentication → API key (live)
PADDLE_API_KEY=pdl_live_...
# Catalog → Prices → copy Price ID (pri_...)
PADDLE_PRICE_NOVEL_UNLOCK=pri_...
PADDLE_PRICE_SUBSCRIPTION=pri_...
# Developer tools → Notifications → webhook secret
PADDLE_WEBHOOK_SECRET=pdl_ntfsec_...
# Optional: set to "sandbox" only for test API host
# PADDLE_ENV=sandbox
